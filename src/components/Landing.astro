---
import LangSwitcher from './LangSwitcher.astro';
import type { Locale, Translations } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const repo = 'https://github.com/sylius-starter/skeleton';
const docs = 'https://sylius-starter.github.io/docs/';
---

<div class="announce" role="note">
  <div class="wrap announce-in">
    <span class="announce-tag">{t.announce.tag}</span>
    <p set:html={t.announce.textHtml} />
  </div>
</div>

<nav>
  <div class="wrap nav-in">
    <a href="#top" class="brand">Sylius Starter<span class="dot"></span></a>
    <div class="nav-links">
      <a href="#pourquoi">{t.nav.why}</a>
      <a href="#souverainete">{t.nav.sovereignty}</a>
      <a href="#developpeurs">{t.nav.developers}</a>
      <a href={repo} target="_blank" rel="noopener" class="btn btn-ghost nav-github">{t.nav.github}</a>
      <a href={docs} target="_blank" rel="noopener" class="btn btn-primary nav-cta">{t.found.ctaDoc}</a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel" aria-label={t.nav.menu}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="nav-panel" id="nav-panel" hidden>
    <div class="wrap">
      <a href="#pourquoi">{t.nav.why}</a>
      <a href="#souverainete">{t.nav.sovereignty}</a>
      <a href="#developpeurs">{t.nav.developers}</a>
      <a href={repo} target="_blank" rel="noopener">{t.nav.github}</a>
      <a href={docs} target="_blank" rel="noopener" class="btn btn-primary">{t.found.ctaDoc}</a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const panel = document.getElementById('nav-panel');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>{t.hero.title}</h1>
      <p class="lead" set:html={t.hero.leadHtml} />
      <div class="hero-cta">
        <a href={repo} target="_blank" rel="noopener" class="btn btn-primary">{t.found.ctaGithub}</a>
        <a href={docs} target="_blank" rel="noopener" class="btn btn-ghost">{t.found.ctaDoc}</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hv-stage">
        <img
          class="hv-shot"
          src={asset('images/hero-storefront.jpg')}
          alt={t.hero.alt}
          width="544"
          height="452"
          loading="eager"
        />
      </div>
    </div>
  </div>
</header>

<section class="own-sec sec-muted" id="pourquoi">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.own.title}</h2>
      <p class="intro">{t.own.intro}</p>
    </div>

    <div class="split">
      <div class="side own">
        <h3>{t.own.ownTitle}</h3>
        <ul class="plist">
          {t.own.ownItems.map((item) => (
            <li><span class="mark">✓</span><span class="t" set:html={item} /></li>
          ))}
        </ul>
      </div>
      <div class="side sub">
        <h3>{t.own.rentTitle}</h3>
        <ul class="plist">
          {t.own.rentItems.map((item) => (
            <li><span class="mark">✕</span><span class="t">{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

  </div>
</section>

<section class="sov-sec" id="souverainete">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.sovereignty.title}</h2>
      <p class="intro">{t.sovereignty.intro}</p>
    </div>

    <div class="sov-grid">
      {t.sovereignty.options.map((option) => (
        <div class="sov-card">
          <span class="tag">{option.tag}</span>
          <h3>{option.title}</h3>
          <p>{option.p}</p>
        </div>
      ))}
    </div>

    <div class="side own sov-promise">
      <h3>{t.sovereignty.promiseTitle}</h3>
      <ul class="plist">
        {t.sovereignty.promiseItems.map((item) => (
          <li><span class="mark">✓</span><span class="t">{item}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="experts sec-muted" id="fiabilite">
  <div class="wrap">
    <div class="exp-grid">
      <div class="section-head">
        <h2>{t.ecosystem.title}</h2>
        <p class="intro">{t.ecosystem.intro}</p>
        <p class="exp-link"><a href="https://sylius.com" target="_blank" rel="noopener">{t.ecosystem.link}</a></p>
      </div>

      <div class="benefits">
        {t.ecosystem.benefits.map((b) => (
          <div class="benefit">
            <span class="bk">{b.title}</span>
            <p>{b.p}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

{t.supporters.logos.length > 0 && (
  <section class="logos-sec" aria-label={t.supporters.label}>
    <div class="wrap logos-in">
      <p class="logos-label">{t.supporters.label}</p>
      <div class="logos-row">
        {t.supporters.logos.map((logo) => (
          <a href={logo.url} target="_blank" rel="noopener" class="logo-mark">
            <img src={asset(logo.src)} alt={logo.name} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="found sec-dark" id="developpeurs">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.found.dev.title}</h2>
    </div>

    <div class="grid">
      <div>
        <p class="lead" set:html={t.found.leadHtml} />
        <ul class="feats">
          {t.found.feats.map((feat) => (
            <li>
              <span class="k">–</span>
              <span class="ft" set:html={feat.html} />
            </li>
          ))}
        </ul>
        <div class="found-cta">
          <a href={repo} target="_blank" rel="noopener" class="btn btn-em">{t.found.ctaGithub}</a>
          <a href={docs} target="_blank" rel="noopener" class="btn btn-light">{t.found.ctaDoc}</a>
        </div>
      </div>

      <div class="term" aria-hidden="true">
        <div class="bar">
          <i style="background:#1dcada"></i><i style="background:#1dcada"></i><i style="background:#1b3d42"></i>
          <span class="p">{t.found.termPath}</span>
        </div>
        <div class="body">
          {t.found.termLines.map((line, i) => (
            <>
              {i > 0 && line.type === 'cmd' && <br />}
              <div class={line.type}>{line.text}</div>
            </>
          ))}
          <br />
          <div class="cmd"><span class="cursor"></span></div>
        </div>
      </div>
    </div>

  </div>
</section>

<section class="event-banner" id="ps-summit">
  <div class="wrap event-inner">
    <div>
      <p class="eyebrow">{t.event.date}</p>
      <h2>{t.event.title}</h2>
      <p>{t.event.p}</p>
    </div>
    <div class="event-cta">
      <a href="https://www.ps-summit.com" target="_blank" rel="noopener" class="btn btn-ghost">{t.event.cta}</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a href="#top" class="brand">Sylius Starter<span class="dot"></span></a>
        <LangSwitcher locale={locale} label={t.lang.label} />
      </div>
      <div class="cols">
        <div class="col">
          <h4>{t.footer.product}</h4>
          <a href="#pourquoi">{t.nav.why}</a>
          <a href="#souverainete">{t.nav.sovereignty}</a>
          <a href="#developpeurs">{t.nav.developers}</a>
        </div>
        <div class="col">
          <h4>{t.footer.resources}</h4>
          <a href={repo} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={docs} target="_blank" rel="noopener" class="hl">Documentation ↗</a>
          <a href="https://sylius.com" target="_blank" rel="noopener">Sylius.com ↗</a>
          <a href="https://www.ps-summit.com" target="_blank" rel="noopener" class="hl">PS Summit 2026 ↗</a>
        </div>
      </div>
    </div>
  </div>
</footer>
