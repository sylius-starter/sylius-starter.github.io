---
import LangSwitcher from './LangSwitcher.astro';
import type { Locale, Translations } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
---

<nav>
  <div class="wrap nav-in">
    <a href="#top" class="brand">Sylius Starter<span class="dot"></span></a>
    <div class="nav-links">
      <a href="#posseder">{t.nav.posseder}</a>
      <a href="#reseau">{t.nav.experts}</a>
      <a href="#success-stories">{t.nav.stories}</a>
      <a href="#fondation">{t.nav.starter}</a>
      <a href="#tutoriels">{t.nav.tutoriels}</a>
      <a href="https://github.com/castor-php/sylius" target="_blank" rel="noopener" class="btn btn-ghost nav-github">{t.nav.github}</a>
      <a href="#offre" class="btn btn-primary nav-cta">{t.nav.cta}</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap">
    <p class="hook reveal">{t.hero.hook}</p>
    <h1 class="reveal"><em>{t.hero.titleEm}</em> {t.hero.titleRest}</h1>
    <p class="lead reveal" set:html={t.hero.leadHtml} />
    <div class="hero-cta reveal">
      <a href="#offre" class="btn btn-primary">{t.hero.cta}</a>
    </div>
  </div>
</header>

<section class="own-sec sec-muted" id="posseder">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow"><span class="n">01</span>{t.own.eyebrow}</p>
      <h2>{t.own.title}</h2>
      <p class="intro">{t.own.intro}</p>
    </div>

    <div class="split reveal">
      <div class="side rent">
        <span class="tag">{t.own.rentTag}</span>
        <h3>{t.own.rentTitle}</h3>
        <ul class="plist">
          {t.own.rentItems.map((item) => (
            <li><span class="mark">✕</span><span class="t">{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="side own">
        <span class="tag">{t.own.ownTag}</span>
        <h3>{t.own.ownTitle}</h3>
        <ul class="plist">
          {t.own.ownItems.map((item) => (
            <li><span class="mark">✓</span><span class="t" set:html={item} /></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="own-cta reveal">
      <p class="own-cta-lead" set:html={t.own.ctaLeadHtml} />
      <a href="#offre" class="btn btn-primary">{t.own.cta}</a>
    </div>
  </div>
</section>

<section class="points-sec" id="sylius">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow"><span class="n">02</span>{t.sylius.eyebrow}</p>
      <h2>{t.sylius.title}</h2>
      <p class="sylius-intro">
        {t.sylius.introBefore}
        <a href="https://sylius.com" target="_blank" rel="noopener">{t.sylius.introLink}</a>.
      </p>
    </div>

    <h3 class="starter-shift reveal">{t.sylius.shift}</h3>

    <div class="card-grid">
      {t.sylius.cards.map((card) => (
        <div class="hcard reveal">
          <span class="n">{card.n}</span>
          <h3>{card.title}</h3>
          <p>{card.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="experts sec-muted" id="reseau">
  <div class="wrap">
    <div class="exp-grid">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="n">03</span>{t.experts.eyebrow}</p>
        <h2>{t.experts.title}</h2>
        <p class="intro">{t.experts.intro}</p>
      </div>

      <div class="benefits reveal">
        {t.experts.benefits.map((b, i) => (
          <div class="benefit">
            <span class="bn">{String(i + 1).padStart(2, '0')}</span>
            <div><span class="bk">{b.title}</span><p>{b.p}</p></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="stories-sec" id="success-stories">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow"><span class="n">04</span>{t.stories.eyebrow}</p>
      <h2>{t.stories.title}</h2>
    </div>

    <article class="story-card story-card--placeholder reveal">
      <div class="story-visual" aria-hidden="true">
        <span class="story-visual-label">{t.stories.visual}</span>
      </div>
      <div class="story-body">
        <span class="badge-soon">{t.stories.badge}</span>
        <h3>{t.stories.cardTitle}</h3>
        <p>{t.stories.cardP}</p>
        <div class="story-cta">
          <a href="#offre" class="btn btn-primary">{t.stories.cta}</a>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="paths-sec sec-muted" id="chemins">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow"><span class="n">05</span>{t.paths.eyebrow}</p>
      <h2>{t.paths.title}</h2>
      <p class="intro">{t.paths.intro}</p>
    </div>

    <div class="split reveal">
      <div class="side own">
        <p class="path-who">{t.paths.specialistWho} <span class="path-or">{t.paths.specialistOr}</span> {t.paths.specialistWho2}</p>
        <h3>{t.paths.specialistTitle}</h3>
        <ul class="plist">
          {t.paths.specialistItems.map((item) => (
            <li><span class="mark">→</span><span class="t">{item}</span></li>
          ))}
        </ul>
        <div class="side-cta"><a href="#offre" class="btn btn-light">{t.paths.specialistCta}</a></div>
      </div>
      <div class="side rent">
        <p class="path-who">{t.paths.devWho} <span class="path-or">{t.paths.devOr}</span> {t.paths.devWho2}</p>
        <h3>{t.paths.devTitle}</h3>
        <ul class="plist">
          {t.paths.devItems.map((item) => (
            <li><span class="mark">→</span><span class="t" set:html={item} /></li>
          ))}
        </ul>
        <div class="side-cta">
          <a href="https://github.com/castor-php/sylius" target="_blank" rel="noopener" class="btn btn-primary">{t.paths.devCtaRepo}</a>
          <a href="#tutoriels" class="btn btn-ghost">{t.paths.devCtaTutorials}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="found sec-dark" id="fondation">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow"><span class="n">06</span>{t.found.eyebrow}</p>
      <h2>{t.found.title}</h2>
    </div>
    <div class="grid">
      <div class="reveal">
        <p class="lead" set:html={t.found.leadHtml} />
        <ul class="feats">
          {t.found.feats.map((feat, i) => (
            <li>
              <span class="k">{String(i + 1).padStart(2, '0')}</span>
              <span class="ft" set:html={feat.html} />
            </li>
          ))}
        </ul>
        <div class="found-cta">
          <a href="https://github.com/castor-php/sylius" target="_blank" rel="noopener" class="btn btn-em">{t.found.ctaGithub}</a>
          <a href="https://github.com/castor-php/sylius#readme" target="_blank" rel="noopener" class="btn btn-light">{t.found.ctaDoc}</a>
        </div>
      </div>

      <div class="term reveal" aria-hidden="true">
        <div class="bar">
          <i style="background:#E7695B"></i><i style="background:#E9B44C"></i><i style="background:#5BC98A"></i>
          <span class="p">{t.found.termPath}</span>
        </div>
        <div class="body">
          {t.found.termLines.map((line, i, arr) => {
            const prev = arr[i - 1];
            const needsBr = i > 0 && prev?.type === 'ok' && line.type === 'cmd';
            return (
              <>
                {needsBr && <br />}
                {line.type === 'cmd' && <div class="cmd">{line.text}</div>}
                {line.type === 'ok' && <div class="ok">{line.text}</div>}
                {line.type === 'dim' && <div class="dim">{line.text}</div>}
              </>
            );
          })}
          <br />
          <div class="cmd"><span class="cursor"></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="tutoriels-sec" id="tutoriels">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow"><span class="n">07</span>{t.tutoriels.eyebrow}</p>
      <h2>{t.tutoriels.title}</h2>
    </div>

    <div class="card-grid">
      {t.tutoriels.cards.map((card) => (
        <div class="hcard soon reveal">
          <span class="badge-soon">{card.badge}</span>
          <h3>{card.title}</h3>
          <p>{card.p}</p>
        </div>
      ))}
    </div>

    <div class="tutoriels-cta reveal">
      <a href="https://github.com/castor-php/sylius#readme" target="_blank" rel="noopener" class="btn btn-primary">{t.tutoriels.cta}</a>
    </div>
  </div>
</section>

<section class="event-banner" id="ps-summit">
  <div class="wrap event-inner">
    <div class="reveal">
      <p class="eyebrow">{t.event.eyebrow}</p>
      <h2>{t.event.title}</h2>
      <p>{t.event.p}</p>
    </div>
    <div class="event-cta reveal">
      <a href="https://ps-summit.com" target="_blank" rel="noopener" class="btn btn-light">{t.event.cta}</a>
    </div>
  </div>
</section>

<section class="offer sec-muted" id="offre">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow"><span class="n">08</span>{t.offer.eyebrow}</p>
        <h2>{t.offer.title}</h2>
      </div>
    </div>

    <div class="plans">
      {t.offer.plans.map((plan) => (
        <div class="plan reveal">
          <div class="name">
            <h3>{plan.name}</h3>
            <span class="price">{plan.price}</span>
          </div>
          <p class="desc">{plan.desc}</p>
          <div class="act">
            <a
              href="https://sylius.com/find-a-partner/"
              target="_blank"
              rel="noopener"
              class:list={['btn', plan.ctaStyle === 'primary' ? 'btn-primary' : 'btn-ghost']}
            >{plan.cta}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a href="#top" class="brand">Sylius Starter<span class="dot"></span></a>
        <p class="about">{t.footer.about}</p>
        <LangSwitcher locale={locale} label={t.lang.label} />
      </div>
      <div class="cols">
        <div class="col">
          <h4>{t.footer.product}</h4>
          <a href="#posseder">{t.nav.posseder}</a>
          <a href="#fondation">{t.nav.starter}</a>
          <a href="#success-stories">{t.nav.stories}</a>
          <a href="#reseau">{t.experts.eyebrow}</a>
          <a href="#offre">{t.nav.cta}</a>
        </div>
        <div class="col">
          <h4>{t.footer.resources}</h4>
          <a href="https://github.com/castor-php/sylius" target="_blank" rel="noopener">GitHub ↗</a>
          <a href="https://github.com/castor-php/sylius#readme" target="_blank" rel="noopener">Documentation ↗</a>
          <a href="#tutoriels">{t.nav.tutoriels}</a>
          <a href="https://sylius.com" target="_blank" rel="noopener">Sylius.com ↗</a>
          <a href="https://ps-summit.com" target="_blank" rel="noopener">PS Summit 2026 ↗</a>
        </div>
      </div>
    </div>
    <div class="legal">
      <span>{t.footer.legal1}</span>
      <span>{t.footer.legal2}</span>
    </div>
  </div>
</footer>
