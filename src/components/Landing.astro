---
import LangSwitcher from './LangSwitcher.astro';
import type { Locale, Translations } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const repo = 'https://github.com/sylius-starter/sylius-starter';
const docs = `${repo}#readme`;
---

<div class="announce" role="note">
  <div class="wrap announce-in">
    <span class="announce-tag">{t.announce.tag}</span>
    <p set:html={t.announce.textHtml} />
  </div>
</div>

<nav>
  <div class="wrap nav-in">
    <a href="#top" class="brand">Sylius Starter<span class="dot"></span></a>
    <div class="nav-links">
      <a href="#saas-vs-sylius">{t.nav.posseder}</a>
      <a href="#votre-projet">{t.nav.paths}</a>
      <a href="#fondation">{t.nav.starter}</a>
      <a href="#ecosysteme">{t.nav.ecosystem}</a>
      <a href={repo} target="_blank" rel="noopener" class="btn btn-ghost nav-github">{t.nav.github}</a>
      <a href="#offre" class="btn btn-primary nav-cta">{t.nav.cta}</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>{t.hero.title}</h1>
      <p class="lead" set:html={t.hero.leadHtml} />
      <div class="hero-cta">
        <a href="#offre" class="btn btn-primary">{t.hero.cta}</a>
        <a href={repo} target="_blank" rel="noopener" class="btn btn-ghost">{t.hero.ctaRepo}</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hv-stage">
        <img
          class="hv-shot"
          src={asset('images/hero-storefront.jpg')}
          alt={t.hero.alt}
          width="544"
          height="452"
          loading="eager"
        />
      </div>
    </div>
  </div>
</header>

<section class="own-sec sec-muted" id="saas-vs-sylius">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.own.title}</h2>
      <p class="intro">{t.own.intro}</p>
    </div>

    <div class="split">
      <div class="side rent">
        <h3>{t.own.rentTitle}</h3>
        <ul class="plist">
          {t.own.rentItems.map((item) => (
            <li><span class="mark">✕</span><span class="t">{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="side own">
        <h3>{t.own.ownTitle}</h3>
        <ul class="plist">
          {t.own.ownItems.map((item) => (
            <li><span class="mark">✓</span><span class="t" set:html={item} /></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="own-cta">
      <a href="#offre" class="btn btn-em">{t.own.migrate}</a>
    </div>
  </div>
</section>

<section class="sov-sec" id="souverainete">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.sovereignty.title}</h2>
      <p class="intro">{t.sovereignty.intro}</p>
    </div>

    <div class="sov-grid">
      {t.sovereignty.options.map((option) => (
        <div class="sov-card">
          <span class="tag">{option.tag}</span>
          <h3>{option.title}</h3>
          <p>{option.p}</p>
        </div>
      ))}
    </div>

    <div class="side own sov-promise">
      <h3>{t.sovereignty.promiseTitle}</h3>
      <ul class="plist">
        {t.sovereignty.promiseItems.map((item) => (
          <li><span class="mark">✓</span><span class="t">{item}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="paths-sec sec-muted" id="votre-projet">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.paths.title}</h2>
    </div>

    <div class="split">
      <div class="side rent">
        <p class="path-who">{t.paths.devWho}</p>
        <h3>{t.paths.devTitle}</h3>
        <ul class="plist">
          {t.paths.devItems.map((item) => (
            <li><span class="mark">→</span><span class="t" set:html={item} /></li>
          ))}
        </ul>
        <div class="side-cta">
          <a href={repo} target="_blank" rel="noopener" class="btn btn-primary">{t.paths.devCtaRepo}</a>
          <a href={docs} target="_blank" rel="noopener" class="btn btn-light">{t.paths.devCtaDoc}</a>
        </div>
      </div>
      <div class="side own">
        <p class="path-who">{t.paths.specialistWho}</p>
        <h3>{t.paths.specialistTitle}</h3>
        <ul class="plist">
          {t.paths.specialistItems.map((item) => (
            <li><span class="mark">→</span><span class="t">{item}</span></li>
          ))}
        </ul>
        <div class="side-cta"><a href="#offre" class="btn btn-em">{t.paths.specialistCta}</a></div>
      </div>
    </div>
  </div>
</section>

<section class="found sec-dark" id="fondation">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.found.title}</h2>
    </div>
    <div class="grid">
      <div>
        <p class="lead" set:html={t.found.leadHtml} />
        <ul class="feats">
          {t.found.feats.map((feat) => (
            <li>
              <span class="k">–</span>
              <span class="ft" set:html={feat.html} />
            </li>
          ))}
        </ul>
        <div class="found-cta">
          <a href={repo} target="_blank" rel="noopener" class="btn btn-em">{t.found.ctaGithub}</a>
          <a href={docs} target="_blank" rel="noopener" class="btn btn-light">{t.found.ctaDoc}</a>
        </div>
      </div>

      <div class="term" aria-hidden="true">
        <div class="bar">
          <i style="background:#1dcada"></i><i style="background:#1dcada"></i><i style="background:#1b3d42"></i>
          <span class="p">{t.found.termPath}</span>
        </div>
        <div class="body">
          {t.found.termLines.map((line, i) => (
            <>
              {i > 0 && line.type === 'cmd' && <br />}
              <div class={line.type}>{line.text}</div>
            </>
          ))}
          <br />
          <div class="cmd"><span class="cursor"></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="experts sec-muted" id="ecosysteme">
  <div class="wrap">
    <div class="exp-grid">
      <div class="section-head">
        <h2>{t.ecosystem.title}</h2>
        <p class="intro">{t.ecosystem.intro}</p>
        <p class="exp-link"><a href="https://sylius.com" target="_blank" rel="noopener">{t.ecosystem.link}</a></p>
      </div>

      <div class="benefits">
        {t.ecosystem.benefits.map((b) => (
          <div class="benefit">
            <span class="bk">{b.title}</span>
            <p>{b.p}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="event-banner" id="ps-summit">
  <div class="wrap event-inner">
    <div>
      <p class="eyebrow">{t.event.date}</p>
      <h2>{t.event.title}</h2>
      <p>{t.event.p}</p>
    </div>
    <div class="event-cta">
      <a href="https://www.ps-summit.com" target="_blank" rel="noopener" class="btn btn-ghost">{t.event.cta}</a>
    </div>
  </div>
</section>

<section class="offer sec-muted" id="offre">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.offer.title}</h2>
      <p class="intro">{t.offer.intro}</p>
    </div>

    <div class="plans">
      {t.offer.plans.map((plan) => (
        <div class="plan">
          <div class="name">
            <h3>{plan.name}</h3>
            <span class="price">{plan.price}</span>
          </div>
          <p class="desc">{plan.desc}</p>
          <div class="act">
            <a
              href="https://sylius.com/find-a-partner/"
              target="_blank"
              rel="noopener"
              class:list={['btn', plan.ctaStyle === 'primary' ? 'btn-primary' : 'btn-ghost']}
            >{plan.cta}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a href="#top" class="brand">Sylius Starter<span class="dot"></span></a>
        <LangSwitcher locale={locale} label={t.lang.label} />
      </div>
      <div class="cols">
        <div class="col">
          <h4>{t.footer.product}</h4>
          <a href="#saas-vs-sylius">{t.nav.posseder}</a>
          <a href="#votre-projet">{t.nav.paths}</a>
          <a href="#fondation">{t.nav.starter}</a>
          <a href="#ecosysteme">{t.nav.ecosystem}</a>
          <a href="#offre">{t.nav.cta}</a>
        </div>
        <div class="col">
          <h4>{t.footer.resources}</h4>
          <a href={repo} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={docs} target="_blank" rel="noopener" class="hl">Documentation ↗</a>
          <a href="https://sylius.com" target="_blank" rel="noopener">Sylius.com ↗</a>
          <a href="https://www.ps-summit.com" target="_blank" rel="noopener" class="hl">PS Summit 2026 ↗</a>
        </div>
      </div>
    </div>
  </div>
</footer>
